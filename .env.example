# Server-side only; never expose these to the browser.
# The security package accepts only these two values.
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Maximum total debit per transfer, including network fees, in lamports.
# Defaults to 1 SOL; server startup rejects non-canonical or out-of-u64 values.
SOLGUARD_MAX_SPEND_LAMPORTS=1000000000
# Optional. Any OpenAI-compatible chat completions API. Without all three,
# only simple commands ("send 0.5 SOL to <address>") are parsed.
# These defaults match scripts/local-llm.sh (the key is unused locally but must be non-empty).
LLM_BASE_URL=http://127.0.0.1:8089/v1
LLM_API_KEY=local
LLM_MODEL=qwen3-4b
